# ── Snowflake Connection ──────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_USER=cms_service_account
SNOWFLAKE_ROLE=CMS_API_ROLE
SNOWFLAKE_WAREHOUSE=CMS_WH
SNOWFLAKE_DATABASE=CMS_DB
SNOWFLAKE_SCHEMA=ANALYTICS

# ── Authentication Method: key_pair | oauth | pat ─────────────────────────────
SNOWFLAKE_AUTH_METHOD=key_pair

# Key-Pair auth (recommended for production)
SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# OAuth (uncomment if using an IdP / OAuth flow)
# SNOWFLAKE_OAUTH_TOKEN=<your_oauth_token>

# PAT / Password (development only – NOT recommended for production)
# SNOWFLAKE_PASSWORD=<your_password_or_pat>

# ── Cortex Analyst Semantic Model ─────────────────────────────────────────────
SEMANTIC_MODEL_STAGE=@CMS_DB.CORTEX.CMS_SEMANTIC_STAGE/cms_semantic_model.yaml

# ── Anthropic / Claude ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-5

# ── FastAPI Server ────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=["http://localhost:8501"]

# ── Streamlit App ─────────────────────────────────────────────────────────────
CMS_API_URL=http://localhost:8000
